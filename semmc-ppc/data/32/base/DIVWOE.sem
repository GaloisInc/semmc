;; Divide Word with Overflow Enabled (XO-form, OE=1, RC=0)
((operands
  ((rT Gprc)
    (rB Gprc)
    (rA Gprc)))
  (in
    (loc.XER op.rA op.rB loc.IP))
  (defs
    ((loc.XER
      (with
        ()
        (concat
          (bvor
            ((_ extract 31 31)
              loc.XER)
            (ite
              (orp
                (bveq op.rB #x00000000)
                (andp
                  (bveq op.rA #x80000000)
                  (bveq op.rB #xffffffff)))
              #b1
              #b0))
          ((_ extract 30 0)
            (concat
              ((_ extract 31 31)
                loc.XER)
              (concat
                (ite
                  (orp
                    (bveq op.rB #x00000000)
                    (andp
                      (bveq op.rA #x80000000)
                      (bveq op.rB #xffffffff)))
                  #b1
                  #b0)
                ((_ extract 29 0)
                  loc.XER)))))))
      (op.rT
        (with
          ()
          (bvsdiv op.rA op.rB)))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x00000004))))))
