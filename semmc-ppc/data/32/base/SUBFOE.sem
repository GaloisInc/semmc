;; SUBFO (XO-form, OE=1, RC=0)
((operands
  ((rT Gprc)
    (rB Gprc)
    (rA Gprc)))
  (in
    (loc.XER op.rA op.rB loc.IP))
  (defs
    ((loc.XER
      (with
        ()
        (concat
          (bvor
            ((_ extract 31 31)
              loc.XER)
            (ite
              (orp
                (andp
                  (andp
                    (bvslt op.rA #x00000000)
                    (bvsge op.rB #x00000000))
                  (bvslt
                    (bvsub op.rB op.rA)
                    #x00000000))
                (andp
                  (andp
                    (bvsge op.rA #x00000000)
                    (bvslt op.rB #x00000000))
                  (bvsge
                    (bvsub op.rB op.rA)
                    #x00000000)))
              #b1
              #b0))
          ((_ extract 30 0)
            (concat
              ((_ extract 31 31)
                loc.XER)
              (concat
                (ite
                  (orp
                    (andp
                      (andp
                        (bvslt op.rA #x00000000)
                        (bvsge op.rB #x00000000))
                      (bvslt
                        (bvsub op.rB op.rA)
                        #x00000000))
                    (andp
                      (andp
                        (bvsge op.rA #x00000000)
                        (bvslt op.rB #x00000000))
                      (bvsge
                        (bvsub op.rB op.rA)
                        #x00000000)))
                  #b1
                  #b0)
                ((_ extract 29 0)
                  loc.XER)))))))
      (op.rT
        (with
          ()
          (bvsub op.rB op.rA)))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x00000004))))))
