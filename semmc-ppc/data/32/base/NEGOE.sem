;; Negate with Overflow Enabled (XO-form, OE=1, RC=0)
((operands
  ((rT Gprc)
    (rA Gprc)))
  (in
    (loc.XER op.rA loc.IP))
  (defs
    ((loc.XER
      (with
        ()
        (concat
          (bvor
            ((_ extract 31 31)
              loc.XER)
            (ite
              (andp
                (bvslt op.rA #x00000000)
                (bveq
                  (bvadd
                    (bvnot op.rA)
                    #x00000001)
                  op.rA))
              #b1
              #b0))
          ((_ extract 30 0)
            (concat
              ((_ extract 31 31)
                loc.XER)
              (concat
                (ite
                  (andp
                    (bvslt op.rA #x00000000)
                    (bveq
                      (bvadd
                        (bvnot op.rA)
                        #x00000001)
                      op.rA))
                  #b1
                  #b0)
                ((_ extract 29 0)
                  loc.XER)))))))
      (op.rT
        (with
          ()
          (bvadd
            (bvnot op.rA)
            #x00000001)))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x00000004))))))
