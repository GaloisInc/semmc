                    (call uf.ppc.memri_offset op.src)))))
            (ite
              (bvule lmw_start #b00001)
              (call
                uf.read_mem.32
                loc.Mem
                (bvadd
                  lmw_ea
                  (bvmul
                    ((_ zero_extend 27)
                      (bvsub #b00001 lmw_start))
                    #x00000004)))
              loc.r1))))
      (loc.r0
        (with
          ()
          (let
            ((lmw_start
              (call uf.ppc.gpr_index op.rD))
              (lmw_ea
                (bvadd
                  (ite
                    (call
                      uf.ppc.is_r0
                      (call uf.ppc.memri_reg op.src))
                    #x00000000
                    (call uf.ppc.memri_reg op.src))
                  ((_ sign_extend 16)
                    (call uf.ppc.memri_offset op.src)))))
            (ite
              (bvule lmw_start #b00000)
              (call
                uf.read_mem.32
                loc.Mem
                (bvadd
                  lmw_ea
                  (bvmul
                    ((_ zero_extend 27)
                      (bvsub #b00000 lmw_start))
                    #x00000004)))
              loc.r0))))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x00000004))))))
