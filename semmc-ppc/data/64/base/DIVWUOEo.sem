;; Divide Word Unsigned with Overflow Enabled and Record (XO-form, OE=1, RC=1)
((operands
  ((rT Gprc)
    (rB Gprc)
    (rA Gprc)))
  (in
    (loc.XER loc.CR op.rA op.rB loc.IP))
  (defs
    ((loc.CR
      (with
        ()
        (call
          df.cmpImm
          (bvslt
            (bvudiv
              ((_ sign_extend 32)
                ((_ extract 31 0)
                  op.rA))
              ((_ sign_extend 32)
                ((_ extract 31 0)
                  op.rB)))
            #x0000000000000000)
          (bvsgt
            (bvudiv
              ((_ sign_extend 32)
                ((_ extract 31 0)
                  op.rA))
              ((_ sign_extend 32)
                ((_ extract 31 0)
                  op.rB)))
            #x0000000000000000)
          #b000
          (concat
            ((_ extract 63 32)
              (concat
                ((_ extract 63 31)
                  loc.XER)
                (concat
                  (ite
                    (bveq
                      ((_ extract 31 0)
                        op.rB)
                      #x00000000)
                    #b1
                    #b0)
                  ((_ extract 29 0)
                    loc.XER))))
            (concat
              (bvor
                ((_ extract 31 31)
                  loc.XER)
                (ite
                  (bveq
                    ((_ extract 31 0)
                      op.rB)
                    #x00000000)
                  #b1
                  #b0))
              ((_ extract 30 0)
                (concat
                  ((_ extract 63 31)
                    loc.XER)
                  (concat
                    (ite
                      (bveq
                        ((_ extract 31 0)
                          op.rB)
                        #x00000000)
                      #b1
                      #b0)
                    ((_ extract 29 0)
                      loc.XER))))))
          loc.CR)))
      (loc.XER
        (with
          ()
          (concat
            ((_ extract 63 32)
              (concat
                ((_ extract 63 31)
                  loc.XER)
                (concat
                  (ite
                    (bveq
                      ((_ extract 31 0)
                        op.rB)
                      #x00000000)
                    #b1
                    #b0)
                  ((_ extract 29 0)
                    loc.XER))))
            (concat
              (bvor
                ((_ extract 31 31)
                  loc.XER)
                (ite
                  (bveq
                    ((_ extract 31 0)
                      op.rB)
                    #x00000000)
                  #b1
                  #b0))
              ((_ extract 30 0)
                (concat
                  ((_ extract 63 31)
                    loc.XER)
                  (concat
                    (ite
                      (bveq
                        ((_ extract 31 0)
                          op.rB)
                        #x00000000)
                      #b1
                      #b0)
                    ((_ extract 29 0)
                      loc.XER))))))))
      (op.rT
        (with
          ()
          (bvudiv
            ((_ sign_extend 32)
              ((_ extract 31 0)
                op.rA))
            ((_ sign_extend 32)
              ((_ extract 31 0)
                op.rB)))))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x0000000000000004))))))
