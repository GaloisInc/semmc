;; Add to Zero Extended with Overflow Enabled (XO-form, OE=1, RC=0)
((operands
  ((rT Gprc)
    (rA Gprc)))
  (in
    (loc.XER op.rA loc.IP))
  (defs
    ((loc.XER
      (with
        ()
        (concat
          ((_ extract 63 32)
            (concat
              ((_ extract 63 31)
                (concat
                  ((_ extract 63 30)
                    loc.XER)
                  (concat
                    ((_ extract 64 64)
                      (bvadd
                        ((_ zero_extend 1)
                          op.rA)
                        ((_ zero_extend 64)
                          ((_ extract 29 29)
                            loc.XER))))
                    ((_ extract 28 0)
                      loc.XER))))
              (concat
                (ite
                  (notp
                    (bveq
                      (bvadd
                        (bvadd
                          ((_ sign_extend 2)
                            op.rA)
                          ((_ sign_extend 2)
                            #x0000000000000000))
                        ((_ zero_extend 65)
                          ((_ extract 29 29)
                            loc.XER)))
                      ((_ sign_extend 2)
                        ((_ extract 63 0)
                          (bvadd
                            (bvadd
                              ((_ sign_extend 2)
                                op.rA)
                              ((_ sign_extend 2)
                                #x0000000000000000))
                            ((_ zero_extend 65)
                              ((_ extract 29 29)
                                loc.XER)))))))
                  #b1
                  #b0)
                ((_ extract 29 0)
                  (concat
                    ((_ extract 63 30)
                      loc.XER)
                    (concat
                      ((_ extract 64 64)
                        (bvadd
                          ((_ zero_extend 1)
                            op.rA)
                          ((_ zero_extend 64)
                            ((_ extract 29 29)
                              loc.XER))))
                      ((_ extract 28 0)
                        loc.XER)))))))
          (concat
            (bvor
              ((_ extract 31 31)
                (concat
                  ((_ extract 63 30)
                    loc.XER)
                  (concat
                    ((_ extract 64 64)
                      (bvadd
                        ((_ zero_extend 1)
                          op.rA)
                        ((_ zero_extend 64)
                          ((_ extract 29 29)
                            loc.XER))))
                    ((_ extract 28 0)
                      loc.XER))))
              (ite
                (notp
                  (bveq
                    (bvadd
                      (bvadd
                        ((_ sign_extend 2)
                          op.rA)
                        ((_ sign_extend 2)
                          #x0000000000000000))
                      ((_ zero_extend 65)
                        ((_ extract 29 29)
                          loc.XER)))
                    ((_ sign_extend 2)
                      ((_ extract 63 0)
                        (bvadd
                          (bvadd
                            ((_ sign_extend 2)
                              op.rA)
                            ((_ sign_extend 2)
                              #x0000000000000000))
                          ((_ zero_extend 65)
                            ((_ extract 29 29)
                              loc.XER)))))))
                #b1
                #b0))
            ((_ extract 30 0)
              (concat
                ((_ extract 63 31)
                  (concat
                    ((_ extract 63 30)
                      loc.XER)
                    (concat
                      ((_ extract 64 64)
                        (bvadd
                          ((_ zero_extend 1)
                            op.rA)
                          ((_ zero_extend 64)
                            ((_ extract 29 29)
                              loc.XER))))
                      ((_ extract 28 0)
                        loc.XER))))
                (concat
                  (ite
                    (notp
                      (bveq
                        (bvadd
                          (bvadd
                            ((_ sign_extend 2)
                              op.rA)
                            ((_ sign_extend 2)
                              #x0000000000000000))
                          ((_ zero_extend 65)
                            ((_ extract 29 29)
                              loc.XER)))
                        ((_ sign_extend 2)
                          ((_ extract 63 0)
                            (bvadd
                              (bvadd
                                ((_ sign_extend 2)
                                  op.rA)
                                ((_ sign_extend 2)
                                  #x0000000000000000))
                              ((_ zero_extend 65)
                                ((_ extract 29 29)
                                  loc.XER)))))))
                    #b1
                    #b0)
                  ((_ extract 29 0)
                    (concat
                      ((_ extract 63 30)
                        loc.XER)
                      (concat
                        ((_ extract 64 64)
                          (bvadd
                            ((_ zero_extend 1)
                              op.rA)
                            ((_ zero_extend 64)
                              ((_ extract 29 29)
                                loc.XER))))
                        ((_ extract 28 0)
                          loc.XER)))))))))))
      (op.rT
        (with
          ()
          ((_ extract 63 0)
            (bvadd
              ((_ zero_extend 1)
                op.rA)
              ((_ zero_extend 64)
                ((_ extract 29 29)
                  loc.XER))))))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x0000000000000004))))))
