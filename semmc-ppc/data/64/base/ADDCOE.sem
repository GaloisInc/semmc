;; Add Carrying with Overflow Enabled (XO-form, OE=1, RC=0)
((operands
  ((rT Gprc)
    (rB Gprc)
    (rA Gprc)))
  (in
    (loc.XER op.rA op.rB loc.IP))
  (defs
    ((loc.XER
      (with
        ()
        (concat
          ((_ extract 63 32)
            (concat
              ((_ extract 63 31)
                (concat
                  ((_ extract 63 30)
                    loc.XER)
                  (concat
                    ((_ extract 64 64)
                      (bvadd
                        ((_ zero_extend 1)
                          op.rA)
                        ((_ zero_extend 1)
                          op.rB)))
                    ((_ extract 28 0)
                      loc.XER))))
              (concat
                (ite
                  (ite
                    (andp
                      (bvslt op.rA #x0000000000000000)
                      (bvslt op.rB #x0000000000000000))
                    (notp
                      (bvslt
                        (bvadd op.rA op.rB)
                        #x0000000000000000))
                    (ite
                      (andp
                        (bvsge op.rA #x0000000000000000)
                        (bvsge op.rB #x0000000000000000))
                      (notp
                        (bvsge
                          (bvadd op.rA op.rB)
                          #x0000000000000000))
                      #false))
                  #b1
                  #b0)
                ((_ extract 29 0)
                  (concat
                    ((_ extract 63 30)
                      loc.XER)
                    (concat
                      ((_ extract 64 64)
                        (bvadd
                          ((_ zero_extend 1)
                            op.rA)
                          ((_ zero_extend 1)
                            op.rB)))
                      ((_ extract 28 0)
                        loc.XER)))))))
          (concat
            (bvor
              ((_ extract 31 31)
                (concat
                  ((_ extract 63 30)
                    loc.XER)
                  (concat
                    ((_ extract 64 64)
                      (bvadd
                        ((_ zero_extend 1)
                          op.rA)
                        ((_ zero_extend 1)
                          op.rB)))
                    ((_ extract 28 0)
                      loc.XER))))
              (ite
                (ite
                  (andp
                    (bvslt op.rA #x0000000000000000)
                    (bvslt op.rB #x0000000000000000))
                  (notp
                    (bvslt
                      (bvadd op.rA op.rB)
                      #x0000000000000000))
                  (ite
                    (andp
                      (bvsge op.rA #x0000000000000000)
                      (bvsge op.rB #x0000000000000000))
                    (notp
                      (bvsge
                        (bvadd op.rA op.rB)
                        #x0000000000000000))
                    #false))
                #b1
                #b0))
            ((_ extract 30 0)
              (concat
                ((_ extract 63 31)
                  (concat
                    ((_ extract 63 30)
                      loc.XER)
                    (concat
                      ((_ extract 64 64)
                        (bvadd
                          ((_ zero_extend 1)
                            op.rA)
                          ((_ zero_extend 1)
                            op.rB)))
                      ((_ extract 28 0)
                        loc.XER))))
                (concat
                  (ite
                    (ite
                      (andp
                        (bvslt op.rA #x0000000000000000)
                        (bvslt op.rB #x0000000000000000))
                      (notp
                        (bvslt
                          (bvadd op.rA op.rB)
                          #x0000000000000000))
                      (ite
                        (andp
                          (bvsge op.rA #x0000000000000000)
                          (bvsge op.rB #x0000000000000000))
                        (notp
                          (bvsge
                            (bvadd op.rA op.rB)
                            #x0000000000000000))
                        #false))
                    #b1
                    #b0)
                  ((_ extract 29 0)
                    (concat
                      ((_ extract 63 30)
                        loc.XER)
                      (concat
                        ((_ extract 64 64)
                          (bvadd
                            ((_ zero_extend 1)
                              op.rA)
                            ((_ zero_extend 1)
                              op.rB)))
                        ((_ extract 28 0)
                          loc.XER)))))))))))
      (op.rT
        (with
          ()
          ((_ extract 63 0)
            (bvadd
              ((_ zero_extend 1)
                op.rA)
              ((_ zero_extend 1)
                op.rB)))))
      (loc.IP
        (with
          ()
          (bvadd loc.IP #x0000000000000004))))))
